# ── AlignForge environment ───────────────────────────────────────────────
# Copy this to .env and fill in real values. .env is gitignored.

# Where to store project data (datasets, artifacts, models, registry).
# Defaults to ./data, ./artifacts, ./models, ./alignforge.db in the repo root.
# Override when running on Colab or a shared machine.
ALIGNFORGE_DATA_DIR=
ALIGNFORGE_ARTIFACTS_DIR=
ALIGNFORGE_MODELS_DIR=
ALIGNFORGE_REGISTRY_DB=

# Judge API key (Part 08). Only needed if using an external judge model.
# Leave blank to use a local judge.
ALIGNFORGE_JUDGE_API_KEY=

# Ollama host (Part 10). Defaults to http://localhost:11434.
ALIGNFORGE_OLLAMA_HOST=
