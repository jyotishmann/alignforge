# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# ── Tooling caches ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Generated artifacts: NEVER commit these ──────────────────────────────
data/raw/
data/processed/
data/cache/
artifacts/
models/
outputs/
*.gguf
*.safetensors
*.bin
*.pt
*.ckpt
wandb/
runs/

# ── Registry database (ships as registry.example.db instead) ─────────────
*.db
*.db-journal
*.sqlite3
!registry.example.db

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Notebook noise ───────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Third-party checkouts ────────────────────────────────────────────────
vendor/llama.cpp/

# ── Explicitly KEEP: these are the deliverable ───────────────────────────
!reports/**
!evals/**/*.jsonl
!docs/**
